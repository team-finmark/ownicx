# --- Supabase (leave empty to run on built-in demo data) ---
NEXT_PUBLIC_SUPABASE_URL=
# Service-role key is used server-side only (API routes / server actions). Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Manager sign-in ---
# Signs the session cookie. 32+ random characters; changing it signs everyone out.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# --- Automation runner ---
# Shared secret for the cron calls (Authorization: Bearer <CRON_SECRET>). 24+ random characters:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=

# --- Public REST API (POS / CRM / eCommerce connect with this key) ---
OWNICX_API_KEY=

# --- WhatsApp ---
# Nothing to set here per salon: managers connect their number in the dashboard (Settings → WhatsApp).
# Optional, platform-wide: Osiq Solutions' Meta app, which turns on the "Continue with Facebook" button
# (Meta Embedded Signup). Leave empty to offer the manual connection only.
META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=
